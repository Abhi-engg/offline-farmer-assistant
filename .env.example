# Offline Farmer Voice Assistant Configuration

# Application
APP_NAME="Offline Farmer AI Voice Assistant"
PORT=8000
HOST="0.0.0.0"

# AI Inference Settings
ASR_MODEL_SIZE="small"
ASR_DEVICE="cpu"
ASR_COMPUTE_TYPE="int8"

# Local LLM Runtime (Ollama / Llama.cpp)
OLLAMA_BASE_URL="http://localhost:11434"
DEFAULT_LLM_MODEL="qwen2.5:1.5b"

# TTS Engine
DEFAULT_TTS_LOCALE="hi-IN"
AUDIO_OUTPUT_DIR="temp_audio"
